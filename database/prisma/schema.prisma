datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         String           @default("CUSTOMER") // ADMIN | CUSTOMER
  layouts      BathroomLayout[]
  orders       Order[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// Stores TileVista-specific visual and 3D asset metadata for OSPOS items.
// Pricing, stock, SKU, and name are always sourced live from OSPOS.
model ItemAssetCatalog {
  id          String   @id @default(uuid())
  osposItemId Int      @unique @map("ospos_item_id")
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  glbUrl      String?  @map("glb_url") @db.VarChar(500)
  scaleX      Float    @default(1.0) @map("scale_x")
  scaleY      Float    @default(1.0) @map("scale_y")
  scaleZ      Float    @default(1.0) @map("scale_z")
  rotationY   Float    @default(0.0) @map("rotation_y")
  tags        String?  @db.VarChar(500) // comma-separated tag list
  material    String?
  finish      String?
  isEnabled   Boolean  @default(true) @map("is_enabled")
  notes       String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("item_asset_catalog")
}

model ProductPackage {
  id              String        @id @default(uuid())
  name            String
  description     String?       @db.VarChar(1000)
  discountPercent Float         @default(0.0)
  price           Float         @default(0.0)
  imageUrl        String?
  items           PackageItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Links a package to OSPOS items by their integer item_id
model PackageItem {
  packageId   String
  package     ProductPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  osposItemId Int            @map("ospos_item_id")

  @@id([packageId, osposItemId])
  @@map("package_item")
}

model Order {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          String      @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  total           Float
  tax             Float
  discount        Float
  shippingAddress String
  paymentMethod   String
  items           OrderItem[]
  synchronizedAt  DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  osposItemId     Int     @map("ospos_item_id") // references ospos.ospos_items.item_id
  itemName        String  @map("item_name")     // snapshot of name at time of purchase
  quantity        Int
  priceAtPurchase Float   @map("price_at_purchase")

  @@map("order_item")
}

model BathroomLayout {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  shape       String // RECTANGLE | L_SHAPE | U_SHAPE
  width       Float // meters
  length      Float // meters
  height      Float // meters
  wallDesigns Json // Array of customized wall styles & tiles
  placements  Json // Array of placed bathware product IDs and coordinate coordinates
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model POSSyncLog {
  id             String   @id @default(uuid())
  osposItemId    Int      @map("ospos_item_id")
  quantitySynced Float
  action         String // RESTOCK | SALE | SYNC
  status         String // SUCCESS | FAILED
  errorMessage   String?
  timestamp      DateTime @default(now())

  @@map("pos_sync_log")
}
